  "attributes": {
    "mapping_name": "m_brz_to_slv_loans",
    "total_attributes": 8,
    "widgets": {
      "LKP_CONTRACTS": [
        {"attr_id": 1, "value": "SELECT CONTRACT_ID, CLIENT_ID FROM bronze.contracts", "line_no": 1}
      ],
      "EXP_CALC_METRICS": [
        {"attr_id": 1, "value": "LOAN_AMOUNT - OUTSTANDING_BALANCE", "line_no": 1},
        {"attr_id": 2, "value": "IIF(LOAN_AMOUNT > 0, (LOAN_AMOUNT - OUTSTANDING_BALANCE) / LOAN_AMOUNT, 0)", "line_no": 2},
        {"attr_id": 3, "value": "TERM_MONTHS - REMAINING_MONTHS", "line_no": 3}
      ],
      "EXP_CATEGORIZE": [
        {"attr_id": 1, "value": "UPPER(DELINQUENCY_STATUS)", "line_no": 1},
        {"attr_id": 2, "value": "IIF(DELINQUENCY_STATUS != 'CURRENT', TRUE, FALSE)", "line_no": 2},
        {"attr_id": 3, "value": "IIF(LOAN_TO_VALUE_RATIO < 0.6, 'LOW', IIF(LOAN_TO_VALUE_RATIO < 0.8, 'MEDIUM', IIF(LOAN_TO_VALUE_RATIO < 0.95, 'HIGH', 'VERY_HIGH')))", "line_no": 3}
      ],
      "FIL_VALID_LOANS": [
        {"attr_id": 1, "value": "NOT ISNULL(LOAN_ID) AND LOAN_AMOUNT > 0", "line_no": 1}
      ]
    }
  }
