# ============================================================================
# Banking ETL - Environment Variables Template
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to git!

# ============================================================================
# Environment
# ============================================================================
ENV=dev  # dev, staging, prod

# ============================================================================
# Spark Configuration
# ============================================================================
SPARK_MASTER=local[*]
SPARK_APP_NAME=banking_etl
SPARK_DRIVER_MEMORY=4g
SPARK_DRIVER_CORES=2
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_INSTANCES=5

# ============================================================================
# Hive/Metastore Configuration
# ============================================================================
HIVE_METASTORE_URI=thrift://localhost:9083
HIVE_WAREHOUSE_DIR=s3a://your-bucket/warehouse

# ============================================================================
# AWS/S3 Configuration
# ============================================================================
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_metadata
DB_USER=etl_user
DB_PASSWORD=change_me

# ============================================================================
# Airflow Configuration
# ============================================================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW_DAGS_DIR=/opt/airflow/dags
AIRFLOW_EMAIL_BACKEND=smtp
AIRFLOW_SMTP_HOST=smtp.gmail.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_USER=your-email@company.com
AIRFLOW_SMTP_PASSWORD=your-email-password
ALERT_EMAIL_RECIPIENTS=oncall@company.com,data-team@company.com

# ============================================================================
# Monitoring & Alerting
# ============================================================================
# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_ENABLED=false

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-key
PAGERDUTY_ENABLED=false

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ENABLED=false

# ============================================================================
# Data Quality
# ============================================================================
DQ_MIN_SCORE_THRESHOLD=0.85
DQ_BAD_RECORDS_PCT_THRESHOLD=0.05

# ============================================================================
# ETL Job Configuration
# ============================================================================
ETL_BATCH_SIZE=10000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=60
ETL_CHECKPOINT_DIR=s3a://your-bucket/checkpoints
ETL_FAILED_RECORDS_DIR=s3a://your-bucket/failed_records

# ============================================================================
# Security
# ============================================================================
ENCRYPTION_KEY_ID=your-kms-key-id
PII_ENCRYPTION_ENABLED=true

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout, file, both
LOG_FILE_PATH=/var/log/banking_etl/etl.log
